# Porta da API
PORT=3333

# Segredo usado para assinar/validar o Token JWT
# Em produção, use um valor longo, aleatório e secreto (nunca versionar!)
JWT_SECRET=uma-chave-bem-secreta-troque-isso
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------
# Conexão com o Postgres na Aiven
# Pegue esses dados no painel do serviço Aiven (Service overview)
# ------------------------------------------------------------------
DB_HOST=seu-servico-postgres.aivencloud.com
DB_PORT=5432
DB_USERNAME=avnadmin
DB_PASSWORD=sua-senha-aiven
DB_DATABASE=defaultdb

# A Aiven exige SSL. Deixe "true" para habilitar.
DB_SSL=true
